# Helius (paid plan) — used by the indexer to fetch real swaps
HELIUS_API_KEY=your_helius_api_key_here

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — REQUIRED for the smart-money leaderboard (indexer persistence)
# Project Settings → API. Use the SERVICE ROLE key (server-side only, secret).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects the /api/cron/index endpoint. If set, Vercel Cron sends it
# automatically; manual calls must pass Authorization: Bearer <secret>.
CRON_SECRET=

# --- Helius cost throttles (all optional; defaults shown) ---
# Lower these to spend fewer Helius credits per run.
# Deep-scan (per-wallet accurate ROI) — the biggest cost:
SEED_MAX_WALLETS=30          # wallets verified per run
SEED_MAX_TXS=500             # max history txs pulled per wallet
# Graduated-coin full capture:
GRAD_MAX_COINS=3             # coins fully ingested per run
GRAD_MAX_TXS=3000            # max history txs pulled per coin
# Chain discovery (follow winners):
CHAIN_MAX_WINNERS=30
CHAIN_MAX_COINS=4
CHAIN_MAX_TXS=3000
# Token-first scan:
INDEX_MAX_TOKENS=15
INDEX_SWAPS_PER_TOKEN=100
# Skip noise wallets in the deep-scan backlog (min trades to be worth verifying):
SCAN_MIN_TRADES=0
# Link tracking (follow SOL out of winners to find their other wallets):
LINK_MAX_WALLETS=20          # winners scanned for distributions per run
LINK_MIN_SOL=0.5             # min SOL transfer to count as funding
LINK_MAX_TXS=500             # max transfer-history txs per winner
# LINK_DENY=addr1,addr2      # extra recipient addresses to ignore (e.g. CEX hot wallets)

# --- GMGN cheap-screen tier (optional; for when gmgn-cli runs on a VPS) ---
# SCREEN_MIN_PROFIT_USD=0    # screen_pass needs realized profit above this
# SCREEN_MIN_TOKENS=5        # and at least this many distinct tokens

